# Copy to .env and fill in. Every key the backend reads is listed here; the
# defaults in src/config/configuration.ts only exist to keep a dev machine
# running, so a server MUST set at least DATABASE_URL and both JWT secrets.

# ===== App =====
# production on a server: it is what makes cookies/logging behave sensibly.
NODE_ENV=development
PORT=3000

# ===== Database (PostgreSQL 14) =====
# Prisma connection string. URL-encode special chars in the password (@ -> %40).
# The schema=public part stays even though the app also uses the `auth` schema —
# multiSchema is declared in prisma/schema.prisma, not here.
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/HR_App?schema=public"

# ===== JWT =====
# Two DIFFERENT long random values. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing either one logs everybody out — that is the intended way to revoke.
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=change-this-to-a-different-long-random-secret
JWT_REFRESH_EXPIRES_IN=30d

# ===== Auth cookie (httpOnly) & CORS =====
# CORS_ORIGINS: every origin the WEB ADMIN is served from, comma-separated, with
# no trailing slash. The browser blocks the login response if its origin is
# missing here. The mobile app is not affected (it sends no Origin header).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_NAME=access_token
# true ONLY behind HTTPS: a secure cookie is dropped by the browser over plain
# HTTP, which looks exactly like "login succeeds but I get logged straight out".
COOKIE_SECURE=false
COOKIE_MAX_AGE_MS=86400000

# ===== Localization =====
DEFAULT_LANG=lo

# ===== Firebase push (optional; in-app notifications work without it) =====
# EITHER an absolute path to the service-account JSON file (preferred on a
# server — keep the file outside the repo), e.g.
#   FIREBASE_SERVICE_ACCOUNT=C:\secrets\firebase-service-account.json
# OR the raw JSON inline. Leave empty to disable push.
FIREBASE_SERVICE_ACCOUNT=

# ===== Seed: default admin, created on FIRST boot only =====
# Skipped when a user with SEED_ADMIN_USERNAME (or the email) already exists, so
# these are ignored entirely on a restored database.
# Login is by USERNAME + password. Change the password before exposing the app.
SEED_ADMIN_EMAIL=admin@hrapp.la
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123

# ===== Email / SMTP (OTP for password + email changes) =====
# LEAVE BLANK in dev: the OTP is printed to the backend console instead of being
# emailed, so the whole flow is testable without a mailbox.
# On a server these MUST be set or nobody can complete an OTP flow.
#
# RECOMMENDED for real delivery to OTHER people: a transactional email service
# (personal Gmail rate-limits + spam-filters mail sent to external recipients).
# Brevo is free for 300 emails/day:
#   1) Sign up at brevo.com, verify your account.
#   2) Add a sender + verify it (Senders, Domains & Dedicated IPs -> Senders).
#   3) SMTP & API -> SMTP: copy your login + generate an SMTP key.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your-brevo-login@example.com     # the SMTP login Brevo shows you
# SMTP_PASS=your-brevo-smtp-key              # the generated SMTP key
# SMTP_FROM=verified-sender@yourdomain.com   # a sender you verified in Brevo
#
# Gmail (fine for testing / sending to yourself, unreliable to others):
# Turn on 2-Step Verification, then create an App password
# (Google Account -> Security -> App passwords) and use the 16 chars, no spaces.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=youraddress@gmail.com
# SMTP_PASS=your16charapppassword
# SMTP_FROM=youraddress@gmail.com
#
# NB: no leading spaces before the keys, and SMTP_FROM should be an address the
# provider is allowed to send as (for Gmail = the SMTP_USER address).
