// HR_App - Prisma schema
// Multi-schema: "auth" (login) and "public" (business data).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["auth", "public"]
}

// ---------------- Enums ----------------

enum Role {
  admin
  employee

  @@schema("auth")
}

enum EmployeeStatus {
  active
  inactive

  @@schema("public")
}

enum RequestStatus {
  pending
  approved
  rejected
  cancelled

  @@schema("public")
}

// Value order MUST match pg_enum.enumsortorder, else `db push` sees a diff and
// tries to recreate the type (which would destroy data).
enum AttendanceStatus {
  on_time
  late
  absent
  leave
  emergency

  @@schema("public")
}

// ---------------- auth schema ----------------

model User {
  id           String    @id @default(uuid()) @db.Uuid
  // Login identifier. Email is kept for notifications / password-reset OTP.
  username     String    @unique
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         Role      @default(employee)
  // Links to public.employees.id (kept as a plain scalar, no cross-schema FK).
  employeeId   String?   @map("employee_id") @db.Uuid
  isActive     Boolean   @default(true) @map("is_active")
  lastLogin    DateTime? @map("last_login") @db.Timestamptz(6)
  // Audit: auth.users.id of who created / last updated this row (scalar, no FK).
  createdById  String?   @map("created_by") @db.Uuid
  updatedById  String?   @map("updated_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  // Null until the row is first updated (set manually on update, never on create).
  updatedAt    DateTime? @map("updated_at") @db.Timestamptz(6)
  // Soft delete: non-null once the account is "deleted". A deleted user is
  // hidden from the default lists and cannot log in, but the row survives so it
  // can be restored (or hard-deleted later).
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@map("users")
  @@schema("auth")
}

/// One-time codes for email-verified password changes (short-lived).
/// userId links to auth.users.id.
model PasswordOtp {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  codeHash  String   @map("code_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  attempts  Int      @default(0)
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("password_otps")
  @@schema("auth")
}

/// One-time codes for verifying a NEW email address before switching to it.
/// The code is sent to `newEmail` (proves the user owns that address).
model EmailOtp {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  newEmail  String   @map("new_email")
  codeHash  String   @map("code_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  attempts  Int      @default(0)
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("email_otps")
  @@schema("auth")
}

// ---------------- public schema ----------------

model Department {
  id        String     @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  employees Employee[]
  positions Position[]

  @@map("departments")
  @@schema("public")
}

model Position {
  id           String     @id @default(uuid()) @db.Uuid
  name         String
  departmentId String     @map("department_id") @db.Uuid
  department   Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  employees    Employee[]

  @@map("positions")
  @@schema("public")
}

model WorkSchedule {
  id               String     @id @default(uuid()) @db.Uuid
  name             String
  startTime        String     @map("start_time") // "HH:mm:ss"
  endTime          String     @map("end_time")
  lateAfterMinutes Int        @default(0) @map("late_after_minutes")
  isActive         Boolean    @default(true) @map("is_active")
  // Audit: auth.users.id of who created / last updated this row (scalar, no FK).
  createdById      String?    @map("created_by") @db.Uuid
  updatedById      String?    @map("updated_by") @db.Uuid
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  // Null until the row is first updated (set manually on update, never on create).
  updatedAt        DateTime?  @map("updated_at") @db.Timestamptz(6)
  employees        Employee[]

  @@map("work_schedules")
  @@schema("public")
}

model Employee {
  id             String         @id @default(uuid()) @db.Uuid
  employeeCode   String         @unique @map("employee_code")
  firstName      String         @map("first_name")
  lastName       String         @map("last_name")
  // NOTE: no email here — email lives ONLY on auth.users (the login account).
  phone          String?
  departmentId   String?        @map("department_id") @db.Uuid
  department     Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  positionId     String?        @map("position_id") @db.Uuid
  positionRef    Position?      @relation(fields: [positionId], references: [id], onDelete: SetNull)
  birthDate      DateTime?      @map("birth_date") @db.Date
  // Employment contract end date. Null = open-ended / permanent (no reminder).
  // The nightly job notifies admins 30 days before and again on the day.
  contractEndDate DateTime?     @map("contract_end_date") @db.Date
  status         EmployeeStatus @default(active)
  workScheduleId String?        @map("work_schedule_id") @db.Uuid
  workSchedule   WorkSchedule?  @relation(fields: [workScheduleId], references: [id], onDelete: SetNull)
  // Audit: auth.users.id of who created / last updated this row (scalar, no FK).
  createdById    String?        @map("created_by") @db.Uuid
  updatedById    String?        @map("updated_by") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  // Null until the row is first updated (set manually on update, never on create).
  updatedAt      DateTime?      @map("updated_at") @db.Timestamptz(6)
  // Soft delete — mirrors auth.users.deletedAt; the two are set together.
  deletedAt      DateTime?      @map("deleted_at") @db.Timestamptz(6)
  attendances       Attendance[]
  leaveRequests     LeaveRequest[]
  emergencyRequests EmergencyRequest[]
  remoteWorkDays    RemoteWorkDay[]

  @@map("employees")
  @@schema("public")
}

model WifiNetwork {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  ssid      String
  bssid     String   @unique
  wifiCode  String?  @map("wifi_code")
  isActive  Boolean  @default(true) @map("is_active")
  // Audit: auth.users.id of who created / last updated this row (scalar, no FK).
  createdById String? @map("created_by") @db.Uuid
  updatedById String? @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  // Null until the row is first updated (set manually on update, never on create).
  updatedAt DateTime? @map("updated_at") @db.Timestamptz(6)

  checkInAttendances  Attendance[] @relation("CheckInWifi")
  checkOutAttendances Attendance[] @relation("CheckOutWifi")

  @@map("wifi_networks")
  @@schema("public")
}

/// An office geofence for GPS-based check-in (used by the web app, which cannot
/// read WiFi). A check-in is accepted when the device's coordinates fall within
/// `radiusMeters` of (latitude, longitude). WiFi (WifiNetwork) still gates the
/// mobile app; the two verification methods coexist.
model OfficeLocation {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  latitude     Float
  longitude    Float
  /// Accepted distance from the point, in metres (e.g. 100).
  radiusMeters Int      @default(100) @map("radius_meters")
  isActive     Boolean  @default(true) @map("is_active")
  // Audit: auth.users.id of who created / last updated (scalar, no FK).
  createdById  String?  @map("created_by") @db.Uuid
  updatedById  String?  @map("updated_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  // Null until first updated (set manually on update, never on create).
  updatedAt    DateTime? @map("updated_at") @db.Timestamptz(6)

  @@map("office_locations")
  @@schema("public")
}

/// Admin-granted "work from home" day: for the (employee, workDate) here, the
/// GPS geofence is skipped so the employee can check in/out from anywhere. One
/// row per employee per day; its mere existence is the permission.
model RemoteWorkDay {
  id          String   @id @default(uuid()) @db.Uuid
  employeeId  String   @map("employee_id") @db.Uuid
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workDate    DateTime @map("work_date") @db.Date
  // auth.users.id of the admin who granted it (scalar, no cross-schema FK).
  createdById String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([employeeId, workDate])
  @@index([workDate])
  @@map("remote_work_days")
  @@schema("public")
}

model Attendance {
  id               String           @id @default(uuid()) @db.Uuid
  employeeId       String           @map("employee_id") @db.Uuid
  employee         Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workDate         DateTime         @map("work_date") @db.Date
  checkInTime      DateTime?        @map("check_in_time") @db.Timestamptz(6)
  checkOutTime     DateTime?        @map("check_out_time") @db.Timestamptz(6)
  checkInLocation  String?          @map("check_in_location")
  checkOutLocation String?          @map("check_out_location")
  checkInWifiId    String?          @map("check_in_wifi_id") @db.Uuid
  checkInWifi      WifiNetwork?     @relation("CheckInWifi", fields: [checkInWifiId], references: [id], onDelete: SetNull)
  checkOutWifiId   String?          @map("check_out_wifi_id") @db.Uuid
  checkOutWifi     WifiNetwork?     @relation("CheckOutWifi", fields: [checkOutWifiId], references: [id], onDelete: SetNull)
  status           AttendanceStatus @default(on_time)
  // Checked out before the schedule's end_time. A separate column, not an
  // AttendanceStatus member, because arriving late and leaving early are
  // independent facts — one status column could only record one of them.
  leftEarly        Boolean          @default(false) @map("left_early")
  workHours        Float?           @map("work_hours")
  note             String?
  // Set when this day is covered by an APPROVED leave / emergency request.
  // A relation (not a bool) so the type NAME can be joined for the UI label.
  // NOTE: a partial-day emergency keeps status on_time/late and carries only
  // the FK — so "is this day covered?" is answered by the FK, never by status.
  leaveRequestId     String?           @map("leave_request_id") @db.Uuid
  leaveRequest       LeaveRequest?     @relation(fields: [leaveRequestId], references: [id], onDelete: SetNull)
  emergencyRequestId String?           @map("emergency_request_id") @db.Uuid
  emergencyRequest   EmergencyRequest? @relation(fields: [emergencyRequestId], references: [id], onDelete: SetNull)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([employeeId, workDate])
  @@index([leaveRequestId])
  @@index([emergencyRequestId])
  @@map("attendances")
  @@schema("public")
}

// ---------------- Leave / Emergency approval workflow ----------------

/// Global ordered approval chain for LEAVE requests (step 1, 2, 3, ...).
/// approverUserId links to auth.users.id (kept as a scalar, cross-schema).
model LeaveApprover {
  id             String   @id @default(uuid()) @db.Uuid
  approverUserId String   @map("approver_user_id") @db.Uuid
  stepOrder      Int      @unique @map("step_order")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("leave_approvers")
  @@schema("public")
}

/// Types of LEAVE (admin-managed): annual leave, personal leave, ...
model LeaveType {
  id            String         @id @default(uuid()) @db.Uuid
  /// English name — also the fallback whenever `laoName` was never filled in.
  name          String
  /// Lao name, shown while the app is in Lao. Nullable because types created
  /// before this column existed have none.
  laoName       String?        @map("lao_name")
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  leaveRequests LeaveRequest[]

  @@map("leave_types")
  @@schema("public")
}

/// Types of EMERGENCY (ສຸກເສີນ) requests (admin-managed): illness, accident, ...
model EmergencyType {
  id                String             @id @default(uuid()) @db.Uuid
  /// English name — also the fallback whenever `laoName` was never filled in.
  name              String
  /// Lao name, shown while the app is in Lao. Nullable: see LeaveType.laoName.
  laoName           String?            @map("lao_name")
  isActive          Boolean            @default(true) @map("is_active")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  emergencyRequests EmergencyRequest[]

  @@map("emergency_types")
  @@schema("public")
}

/// Pool of users who MAY approve emergency requests (requester picks one).
model EmergencyApprover {
  id             String   @id @default(uuid()) @db.Uuid
  approverUserId String   @unique @map("approver_user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("emergency_approvers")
  @@schema("public")
}

/// A leave request submitted by an employee (sequential approval).
model LeaveRequest {
  id          String             @id @default(uuid()) @db.Uuid
  employeeId  String             @map("employee_id") @db.Uuid
  employee    Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId String             @map("leave_type_id") @db.Uuid
  leaveType   LeaveType          @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  reason      String
  startDate   DateTime           @map("start_date") @db.Date
  endDate     DateTime           @map("end_date") @db.Date
  status      RequestStatus      @default(pending)
  currentStep Int                @default(1) @map("current_step")
  steps       LeaveRequestStep[]
  // Attendance days materialized when this request was fully approved.
  attendances Attendance[]
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("leave_requests")
  @@schema("public")
}

/// Snapshot of the approval chain at submission time (per request).
model LeaveRequestStep {
  id             String        @id @default(uuid()) @db.Uuid
  leaveRequestId String        @map("leave_request_id") @db.Uuid
  leaveRequest   LeaveRequest  @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)
  approverUserId String        @map("approver_user_id") @db.Uuid
  stepOrder      Int           @map("step_order")
  status         RequestStatus @default(pending)
  comment        String?
  decidedAt      DateTime?     @map("decided_at") @db.Timestamptz(6)
  /// True when the system approved this step instead of a person: the approver
  /// on it IS the requester, and nobody reviews their own leave. Kept as its own
  /// column (not a magic `comment`) so the timeline can label it honestly.
  auto           Boolean       @default(false)

  @@map("leave_request_steps")
  @@schema("public")
}

/// An emergency (ສຸກເສີນ) request submitted by an employee (single chosen approver).
model EmergencyRequest {
  id              String        @id @default(uuid()) @db.Uuid
  employeeId      String        @map("employee_id") @db.Uuid
  employee        Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  emergencyTypeId String        @map("emergency_type_id") @db.Uuid
  emergencyType   EmergencyType @relation(fields: [emergencyTypeId], references: [id], onDelete: Restrict)
  approverUserId  String        @map("approver_user_id") @db.Uuid
  reason          String
  startDate       DateTime      @map("start_date") @db.Date
  endDate         DateTime      @map("end_date") @db.Date
  // Optional time window ("HH:mm"). Either BOTH are set (a partial-day request)
  // or both are null (whole-day request). Same convention as WorkSchedule.
  startTime       String?       @map("start_time")
  endTime         String?       @map("end_time")
  status          RequestStatus @default(pending)
  comment         String?
  decidedAt       DateTime?     @map("decided_at") @db.Timestamptz(6)
  /// True when the system approved this on creation because the pool held
  /// nobody but the requester — there was no one else who could decide it.
  auto            Boolean       @default(false)
  // Attendance days materialized when this request was approved.
  attendances     Attendance[]
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("emergency_requests")
  @@schema("public")
}

/// In-app notification (also mirrored to Firebase push when configured).
model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      String
  title     String
  body      String
  refId     String?  @map("ref_id") @db.Uuid
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, isRead])
  @@map("notifications")
  @@schema("public")
}

/// FCM device tokens for push notifications (one user may have several).
model DeviceToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  platform  String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("device_tokens")
  @@schema("public")
}
